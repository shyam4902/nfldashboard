# Supabase REST endpoint for the existing roster scripts.
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
# Supabase publishable/anonymous key for existing read/export scripts.
SUPABASE_ANON_KEY=replace-me
# Server-only secret key for update_rosters_from_espn.js --write. Never expose it to browser code.
SUPABASE_SECRET_KEY=replace-me
