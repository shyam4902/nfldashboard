<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nfldashboard.rosterupdate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>/absolute/path/to/NFL_Main/nfldashboard/update_rosters_from_espn.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/absolute/path/to/NFL_Main/nfldashboard</string>
    <key>StartInterval</key>
    <integer>86400</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/nfldashboard-rosterupdate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nfldashboard-rosterupdate.log</string>
</dict>
</plist>
